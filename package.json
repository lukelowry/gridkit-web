{
  "name": "gridkit-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "check": "pnpm -r check",
    "test": "vitest run",
    "e2e": "pnpm -F @gridkit/ui e2e",
    "smoke": "pnpm -F @gridkit/solver smoke && pnpm -F @gridkit/ui smoke",
    "deploy:web": "pnpm -F @gridkit/static deploy:web",
    "preview:web": "pnpm -F @gridkit/static preview:web",
    "deploy:library": "pnpm -F @gridkit/library-service deploy:library"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
