# Copy to .env (never committed) and change what you need; every program here reads .env.
# The process environment overrides it.

# The local stack's editor, on this machine.
GRIDKIT_EDITOR_PORT=8080

# Each service: the port the local stack publishes it on, where deployments of the editor find it (blank: this machine's own, at that
# port), and the token they add to what they forward. Pages never see a token.

# The solver, and the names it answers to; add its public name when other machines use it.
GRIDKIT_SOLVER_PORT=8081
GRIDKIT_SOLVER_URL=
GRIDKIT_SOLVER_TOKEN=
GRIDKIT_SOLVER_HOSTS=localhost,127.0.0.1,[::1]

# The library, and the folder the local one serves read-only: everything in it is public to whoever reaches the library.
GRIDKIT_LIBRARY_PORT=8082
GRIDKIT_LIBRARY_URL=
GRIDKIT_LIBRARY_TOKEN=
GRIDKIT_LIBRARY_DIR=./library

# The GridKit runtime the solver builds on (a develop-perf image: the solver reads its binary output), and the published
# images to run instead of local builds.
GRIDKIT_RUNTIME_IMAGE=ghcr.io/birchfieldresearchgroup/gridkit:develop-perf
# The GridKit module the static deployment runs in the browser instead of a solver.
GRIDKIT_WASM_IMAGE=ghcr.io/birchfieldresearchgroup/gridkit-wasm:develop-perf
GRIDKIT_REGISTRY=
GRIDKIT_VERSION=local
