{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gridkit-editor",
  "account_id": "bcfa915786f8fd9c888645e96afbcb0c",
  "compatibility_date": "2026-10-20",
  // dist/ (build.ts): the editor with GridKit beside it, running studies in the page. This Worker answers api/library/ from the
  // library Worker, bound to it here; with the library's token, a secret, only where the library keeps one.
  "main": "worker.ts",
  "assets": { "directory": "./dist", "run_worker_first": ["/api", "/api/*"] },
  "services": [{ "binding": "LIBRARY", "service": "gridkit-library" }],
  // Production, at pdsim.us, the domain this file alone names: a route, since pdsim.us keeps a DNS record from before. Once
  // that record is deleted, { "pattern": "pdsim.us", "custom_domain": true } makes this Worker its origin. A preview is a
  // version of this same Worker, with its secrets, at its own workers.dev address (`pnpm preview:web`); there is never a
  // second Worker.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "pdsim.us/*", "zone_name": "pdsim.us" }]
}
