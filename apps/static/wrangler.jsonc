{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gridkit-ui",
  "account_id": "bcfa915786f8fd9c888645e96afbcb0c",
  "compatibility_date": "2026-10-20",
  // dist/ (build.ts), files only: the UI with GridKit beside it, running studies in the page and reading the library Worker.
  "assets": { "directory": "./dist" },
  // Production, at pdsim.us, the domain this file alone names: a route, since pdsim.us keeps a DNS record from before. Once
  // that record is deleted, { "pattern": "pdsim.us", "custom_domain": true } makes this Worker its origin. A preview is a
  // version of this same Worker at its own workers.dev address (`pnpm preview:web`); there is never a second Worker.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "pdsim.us/*", "zone_name": "pdsim.us" }]
}
