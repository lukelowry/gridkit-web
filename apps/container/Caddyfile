{
	admin off
	persist_config off
	auto_https off
	grace_period 5s
	servers {
		protocols h1
	}
}

:8080 {
	root * /srv
	import /etc/caddy/headers.caddy

	handle /health {
		respond 204
	}

	# Each service is mounted at /api/<name>/ and sees the rest as its own root: only this UI's own pages reach it, browser
	# credentials never do, and the solver's token is added where one is set. The library is the container beside this one.
	# `pnpm smoke` checks each rule, runs studies, and opens library cases through it.
	@api path /api /api/*
	handle @api {
		route {
			@foreign expression `{http.request.header.Origin} != "" && !{http.request.header.Origin}.endsWith("//" + {http.request.hostport})`
			header @foreign Content-Type application/json
			respond @foreign `{"code":"forbidden","message":"Use this UI's own page."}` 403
			handle_path /api/solver/* {
				@solvertoken expression `"{$GRIDKIT_SOLVER_TOKEN}" != ""`
				route {
					request_header -Authorization
					request_header @solvertoken Authorization "Bearer {$GRIDKIT_SOLVER_TOKEN}"
				}
				reverse_proxy {$GRIDKIT_SOLVER_URL} {
					header_up Host {upstream_hostport}
					header_up -Origin
					header_up -Cookie
					transport http {
						keepalive 4s
						compression off
					}
				}
			}
			handle_path /api/library/* {
				request_header -Authorization
				reverse_proxy library:8080 {
					header_up Host {upstream_hostport}
					header_up -Origin
					header_up -Cookie
				}
			}
			header Content-Type application/json
			respond `{"code":"missing","message":"This UI has no such service."}` 404
		}
	}

	# Vite names each built asset by its content, so those never change.
	@immutable {
		path_regexp ^/assets/.+-[A-Za-z0-9_-]{8}\.[A-Za-z0-9.]+$
		file
	}
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		encode zstd gzip
		file_server
	}

	handle {
		header Cache-Control no-cache
		encode zstd gzip
		file_server
	}
}
